{
  "name": "omegaalfa/collection",
  "type": "library",
  "license": "MIT",
  "description": "High-performance, memory-efficient PHP collection library with lazy evaluation support",
  "keywords": [
    "array",
    "collection",
    "perfomance",
    "memory"
  ],
  "authors": [
    {
      "name": "wrt",
      "email": "webdesenvolver.agenda@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "omegaalfa/fiber-event-loop": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Omegaalfa\\Collection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Omegaalfa\\Collection\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^11.0 || ^12.0",
    "phpstan/phpstan": "^2.0",
    "doctrine/collections": "^2.2 || 3.0.x-dev"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src tests --level=1"
  }
}
